{
  "manifest_version": 3,
  "default_locale": "en",
  "name": "Canvas Workspace Capture",
  "version": "0.3.0",
  "key": "",
  "description": "__MSG_extDescription__",
  "permissions": [
    "contextMenus",
    "storage",
    "nativeMessaging",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "app-icon.png",
    "32": "app-icon.png",
    "48": "app-icon.png",
    "128": "app-icon.png"
  },
  "action": {
    "default_title": "__MSG_extName__",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "app-icon.png",
      "32": "app-icon.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'self' http://127.0.0.1:* http: https:"
  }
}
