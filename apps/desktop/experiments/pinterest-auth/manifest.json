{
  "manifest_version": 3,
  "name": "画布工作区 Pinterest 登录（开发版）",
  "version": "0.0.3",
  "key": "",
  "description": "仅在用户确认时，将当前浏览器中的 Pinterest 站点会话接入本机 画布工作区。非正式发布功能。",
  "permissions": [
    "cookies",
    "nativeMessaging",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": [
    "https://*.pinterest.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "画布工作区 · Pinterest 接续",
    "default_popup": "connect.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src http://127.0.0.1:*"
  }
}
