{
  "name": "canvas-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "Standalone extraction of the original canvas creation workspace, frontend and backend.",
  "packageManager": "pnpm@10.33.2",
  "engines": { "node": "~24", "pnpm": ">=10.33.2 <11" },
  "scripts": {
    "guard": "tsx scripts/guard.ts",
    "typecheck": "tsc -p tsconfig.tools.json --noEmit && pnpm -r --workspace-concurrency=2 --if-present run typecheck",
    "tools-dev": "tsx tools/dev/src/cli.ts"
  },
  "devDependencies": {
    "@types/node": "24.12.2",
    "tsx": "4.22.3",
    "typescript": "5.9.3",
    "vitest": "4.1.6"
  }
}
