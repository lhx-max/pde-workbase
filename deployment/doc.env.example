# External mode-600 runtime env. Replace example origins, IDs and service key.
NODE_ENV=production
DOC_STORAGE_MODE=appwrite
DOC_DATA_DIR=/tmp/doc-working
DOC_SERVER_PORT=19000
DOC_APPWRITE_SINGLE_WRITER=true
DOC_REPLICAS=1
APPWRITE_ENDPOINT=https://frontend-cloud.corp.kuaishou.com/v1
APPWRITE_PROJECT=grworkspace
APPWRITE_DATABASE=doc_app_staging_v1
APPWRITE_BUCKET=doc_assets_staging
APPWRITE_RUNTIME_COLLECTION=app_runtime_state
APPWRITE_API_KEY=REPLACE_WITH_DOC_RUNTIME_SERVICE_KEY
DOC_RUNTIME_NAMESPACE=doc-staging-v1
MAV_API_ORIGIN=https://ma-authority.example.invalid
DOC_PUBLIC_ENDPOINT=https://doc.example.invalid
DOC_PUBLIC_WEB=https://doc.example.invalid
CANVAS_ORIGIN=https://canvas.example.invalid
DOC_ALLOWED_ORIGINS=https://ma.example.invalid
APP_WRITE_GRANTS_JSON=[]
