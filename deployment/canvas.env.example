# External mode-600 runtime env. Replace example origins, IDs and service key.
NODE_ENV=production
CANVAS_STORAGE_MODE=appwrite
CANVAS_DATA_DIR=/tmp/canvas-working
CANVAS_PORT=17456
CANVAS_APPWRITE_SINGLE_WRITER=true
CANVAS_REPLICAS=1
APPWRITE_ENDPOINT=https://frontend-cloud.corp.kuaishou.com/v1
APPWRITE_PROJECT=grworkspace
APPWRITE_DATABASE=canvas_app_staging_v1
APPWRITE_BUCKET=canvas_assets_staging
APPWRITE_RUNTIME_COLLECTION=app_runtime_state
APPWRITE_API_KEY=REPLACE_WITH_CANVAS_RUNTIME_SERVICE_KEY
CANVAS_RUNTIME_NAMESPACE=canvas-staging-v1
MAV_API_ORIGIN=https://ma-authority.example.invalid
CANVAS_WEB_URL=https://ma.example.invalid
CANVAS_TRUSTED_APP_ORIGINS=https://image.example.invalid,https://doc.example.invalid,https://sketch.example.invalid
CANVAS_IMAGE_APP_ORIGIN=https://image.example.invalid
CANVAS_IMAGE_APPLICATION_ID=image
# Exact verified team/biz/user/application/instance action grants; [] is read-only.
APP_WRITE_GRANTS_JSON=[]
