{
  "name": "@ks-designai/app-cloud-state",
  "version": "0.1.2",
  "type": "module",
  "license": "Apache-2.0",
  "description": "Versioned JSON state slots on an Appwrite collection under a strict single-writer contract.",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": "~24"
  },
  "devDependencies": {
    "@types/node": "24.12.2",
    "typescript": "5.9.3",
    "vitest": "4.1.6"
  }
}
