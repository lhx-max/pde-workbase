[
 {
  "appId": "canvas",
  "name": "画布",
  "endpoint": "/api/apps/canvas",
  "status": "active",
  "manifest": {
   "appId": "canvas",
   "name": "画布",
   "version": "0.1.0",
   "protocolVersion": 1,
   "cardKinds": [
    "image",
    "video",
    "storyboard"
   ],
   "actions": [
    {
     "actionId": "canvas.create",
     "mode": "app",
     "async": false
    },
    {
     "actionId": "canvas.rename",
     "mode": "instance",
     "async": false
    },
    {
     "actionId": "canvas.delete",
     "mode": "instance",
     "async": false
    },
    {
     "actionId": "canvas.duplicate",
     "mode": "instance",
     "async": false,
     "available": false
    }
   ],
   "operations": [
    "node.create",
    "node.delete",
    "node.duplicate",
    "node.move",
    "node.resize",
    "node.rename",
    "node.update",
    "edge.connect",
    "edge.disconnect",
    "image.attach",
    "image.select",
    "image.replace",
    "image.transform",
    "video.attach",
    "video.select",
    "video.configure",
    "sketch.create",
    "sketch.update",
    "document.create",
    "document.select",
    "document.begin",
    "storyboard.shot.add",
    "storyboard.shot.update",
    "storyboard.shot.delete",
    "storyboard.shot.move",
    "storyboard.shot.duplicate",
    "storyboard.shot.references",
    "operation.undo"
   ],
   "endpoints": {
    "instances": "GET /api/apps/canvas/instances",
    "state": "GET /api/apps/canvas/instances/{id}/state",
    "node": "GET /api/apps/canvas/instances/{id}/nodes/{nodeId}",
    "nodeHistory": "GET /api/apps/canvas/instances/{id}/nodes/{nodeId}/history",
    "operations": "POST /api/apps/canvas/instances/{id}/operations",
    "operationReceipt": "GET /api/apps/canvas/instances/{id}/operations/{operationId}",
    "files": "GET|PUT /api/apps/canvas/instances/{id}/files?path=",
    "bindings": "GET|PUT /api/apps/canvas/instances/{id}/bindings",
    "events": "GET /api/apps/canvas/instances/{id}/events (SSE)",
    "snapshot": "GET /api/apps/canvas/instances/{id}/snapshot"
   },
   "events": {
    "available": true,
    "types": [
     "card.created",
     "card.updated",
     "card.deleted",
     "edge.created",
     "edge.updated",
     "edge.deleted"
    ]
   },
   "snapshots": {
    "available": true
   },
   "agentSurface": {
    "readState": "GET /api/apps/canvas/instances/{instanceId}/state",
    "writeAction": "POST /api/apps/canvas/instances/{instanceId}/actions/{actionId}",
    "cards": {
     "text": {
      "read": [
       "title",
       "text",
       "projectFilePath"
      ],
      "write": {
       "title": "node.rename",
       "text": "node.update"
      },
      "boundApp": {
       "appId": "doc",
       "readField": "text",
       "writeAction": "doc.write"
      }
     },
     "image": {
      "read": [
       "name",
       "path"
      ],
      "write": {
       "path": "image.replace"
      }
     },
     "sketch": {
      "read": [
       "title",
       "projectFilePath"
      ],
      "write": {
       "document": "sketch.update",
       "title": "node.rename"
      }
     },
     "storyboard": {
      "read": [
       "title",
       "storyboard"
      ],
      "write": {
       "shot": "storyboard.shot.update",
       "title": "node.rename"
      }
     },
     "video": {
      "read": [
       "title",
       "text",
       "projectFilePath",
       "videoAspect",
       "videoLength",
       "videoResolution"
      ],
      "write": {
       "config": "video.configure",
       "path": "video.attach",
       "title": "node.rename"
      }
     },
     "page": {
      "read": [
       "title",
       "projectFilePath",
       "artifactFormat"
      ],
      "write": {
       "path": "document.select",
       "title": "node.rename"
      }
     },
     "presentation": {
      "read": [
       "title",
       "projectFilePath",
       "artifactFormat"
      ],
      "write": {
       "path": "document.select",
       "title": "node.rename"
      }
     },
     "card.demo.memo": {
      "read": [
       "title",
       "data"
      ],
      "write": {}
     },
     "card.drama.audio": {
      "read": [
       "title",
       "data",
       "projectFilePath"
      ],
      "write": {
       "script": "card.drama.audio.script",
       "segments": "card.drama.audio.upsert",
       "masterGain": "card.drama.audio.gain",
       "trimStartMs": "card.drama.audio.trim",
       "trimEndMs": "card.drama.audio.trim",
       "captions": "card.drama.audio.analyze",
       "dubbingDoc": "card.drama.audio.compose"
      }
     }
    }
   },
   "tenancy": "required",
   "execution": "receipt",
   "receiptSupport": {
    "operations": "durable",
    "lifecycle": "durable",
    "condition": "Configured durable runtime state; caller retains idempotency-key for create/rename/delete",
    "pending": "CANVAS_OPERATION_UNCERTAIN; do not retry under a new key"
   }
  },
  "registeredAt": "2026-11-07T09:53:14.735Z"
 }
]