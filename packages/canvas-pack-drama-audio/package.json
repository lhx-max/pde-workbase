{
  "name": "@bezier/canvas-pack-drama-audio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "短剧配音音频编辑卡片包：分段/停顿/音量/裁剪 EDL 编辑器（PDE 挑战赛）",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.mjs"
    }
  },
  "scripts": {
    "demo": "CANVAS_STORAGE_MODE=local-test pnpm --dir ../.. tools-dev run web --data-dir \"$PWD/demo/runtime\"",
    "demo:import": "node demo/import.ts",
    "demo:repair": "node demo/repair.ts",
    "build": "esbuild src/server.ts --bundle --format=esm --platform=node --target=node24 --packages=external --outfile=dist/server.mjs && tsc -p tsconfig.build.json --emitDeclarationOnly",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.28",
    "esbuild": "0.28.0",
    "typescript": "5.9.3",
    "vitest": "4.1.6"
  },
  "dependencies": {
    "@bezier/canvas-card-sdk": "workspace:*"
  }
}
