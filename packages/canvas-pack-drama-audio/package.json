{
  "name": "@bezier/canvas-pack-drama-audio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "短剧配音音频编辑卡片包：分段/停顿/音量/裁剪 EDL 编辑器（PDE 挑战赛）",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.mjs"
    }
  },
  "scripts": {
    "voice": "TTS=\"${DRAMA_TTS_HOME:-$PWD/../../.runtime/local-tts}\"; cd \"$TTS/VoxCPM\" && HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 \"$TTS/.venv/bin/python\" app.py --host 127.0.0.1 --port 8808 --model-id \"$TTS/VoxCPM2\" --device auto",
    "build": "esbuild src/server.ts --bundle --format=esm --platform=node --target=node24 --packages=external --outfile=dist/server.mjs && tsc -p tsconfig.build.json --emitDeclarationOnly",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "react": "18.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.2",
    "@types/react": "18.3.28",
    "@vitest/coverage-v8": "4.1.6",
    "esbuild": "0.28.0",
    "jsdom": "29.1.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.9.3",
    "vitest": "4.1.6"
  },
  "dependencies": {
    "@bezier/canvas-card-sdk": "workspace:*"
  }
}
