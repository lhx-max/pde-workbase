{
  "name": "@bezier/workbench-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Product-neutral workflow editor UI and browser selection state.",
  "main": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./icon": {
      "types": "./dist/Icon.d.ts",
      "default": "./src/Icon.tsx"
    },
    "./styles.css": "./src/workbench-ui.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json --emitDeclarationOnly",
    "test": "vitest run tests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@xyflow/react": "12.8.5",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "dependencies": {
    "@bezier/components": "workspace:*",
    "@bezier/contracts": "workspace:*",
    "@bezier/workbench-core": "workspace:*",
    "micromark": "4.0.2",
    "micromark-extension-gfm": "3.0.0",
    "lucide-react": "0.468.0"
  },
  "devDependencies": {
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "@xyflow/react": "12.8.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.9.3",
    "vitest": "4.1.6"
  }
}
